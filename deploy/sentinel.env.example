# Copy to ~/.config/recallroom/sentinel.env on the host that runs sentinel.
RECALLROOM_HOME=/home/ubuntu/recallroom
# Switch's agent bridge (Switch Console shows it as the server's API URL).
SWITCH_URL=http://127.0.0.1:50429
# A one-line file holding a registration key from the Switch Gateway (API Keys page).
# Read once, on first start; afterwards sentinel uses data/sentinel-identity.properties.
SWITCH_REGISTRATION_TOKEN_FILE=/home/ubuntu/.config/recallroom/registration-token
# The QA Head's Switch sender id(s), comma separated. Send `@sentinel whoami` from the QA Head's
# account in recall-hq to see it. Ids, never display names: a name can be changed by anyone.
RECALLROOM_QA_HEADS=
# Minutes between automatic feed checks; 0 means only when asked (`@sentinel scan latest`).
RECALLROOM_POLL_MINUTES=0
